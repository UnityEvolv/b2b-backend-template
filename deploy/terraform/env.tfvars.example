# Copy to env.tfvars (git-ignored) and fill in. Everything the environment
# is reached at derives from base_hostname; changing it re-points every app,
# redirect and email link with no code change.
project       = "my-gcp-project"
region        = "europe-west2"
name_prefix   = "b2bapp-dev"
environment   = "dev"
base_hostname = "app.example.com"

# The product, in emails, pages and tokens.
product_name = "B2B App"
product_id   = "b2bapp"
# Empty: "B2B App <no-reply@mail.app.example.com>".
email_from = ""

# The data-owner manifest: `go run ./cmd/dataowners > data-owners.json`.
# Empty uses the template's own, deploy/terraform/data-owners.json. A product
# with services of its own prints it with its DATA_OWNERS and passes that
# same value as data_owners_config.
data_owners_file   = ""
data_owners_config = ""

# A product's registrations and other settings every service gets.
# service_env = {
#   PLANS             = "..."
#   PERMISSION_GROUPS = "..."
# }

# The Stripe price of each paid band, from the plan registry. Empty until
# Stripe is set up.
stripe_prices = {
  # team     = "price_..."
  # business = "price_..."
}

# The first platform operator: invited by email when identity starts and the
# platform org is empty. Harmless to leave set once someone has accepted.
bootstrap_operator_email = ""

# The repositories whose main branch may deploy, as owner/repo. Empty makes
# no deploy identity.
github_repositories = []

# Spend alert. The billing account id is on the billing page.
billing_account = ""
monthly_budget  = 100
alert_email     = ""

# Images: a commit sha once CI pushes them.
image_tag     = "latest"
web_image_tag = "latest"

# Issued secrets go in secrets.auto.tfvars (git-ignored), never here:
# external_secrets = {
#   resend_api_key        = "re_..."
#   resend_webhook_secret = "whsec_..."
#   recaptcha_secret      = "..."
#   sentry_dsn_backend    = "https://...@....ingest.sentry.io/..."
#   stripe_secret_key     = "sk_test_..."
#   stripe_webhook_secret = "whsec_..."
# }
